{
  "version": 1,
  "sdk_version": "3.6.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://uehfueojisliqxwdlkxt.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "futquick",
      "version": "0.1.0",
      "title": "Futquick"
    },
    "tools": [
      {
        "name": "list_open_games",
        "title": "Listar jogos abertos",
        "description": "List upcoming open games (peladas) with free slots, optionally filtered by city or sport style.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "city": {
              "description": "City name to filter by, e.g. São Paulo.",
              "type": "string",
              "minLength": 1
            },
            "field_type": {
              "description": "Sport/style id, e.g. campo, society, futsal, basquete, volei.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "description": "Max games to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_game",
        "title": "Ver detalhes do jogo",
        "description": "Get the details of one game (pelada) by its id.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Game id returned by list_open_games."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_my_organized_games",
        "title": "Meus jogos organizados",
        "description": "List upcoming games organized by the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_my_profile",
        "title": "Meu perfil",
        "description": "Get the signed-in user's Futquick profile (name, city, level and posture averages).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
